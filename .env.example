# Success page and registration-session link signing (optional; falls back to GOOGLE_SHEETS_PRIVATE_KEY / MAIL_PASSWORD)
SUCCESS_TOKEN_SECRET=

# Screenshot verification runs locally in the browser; no AI API key is required.

# Cloudflare Turnstile (free). Create a widget for msdigitalskillhub.com.ng.
# Set both keys to enable the security check on registration start.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Zoho mail for msdigitalskillhub.com.ng)
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=info@msdigitalskillhub.com.ng
MAIL_PASSWORD=

# Google Sheets service account (share the spreadsheet with the client email)
GOOGLE_SHEETS_CLIENT_EMAIL=
# Keep the \n escapes as-is if that is how the key was pasted; both forms work
GOOGLE_SHEETS_PRIVATE_KEY=
SPREADSHEET_ID=
